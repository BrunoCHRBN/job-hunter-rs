# Chave de API do Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="SUA_CHAVE_GEMINI_AQUI"

# Caminho do banco de dados SQLite local
DATABASE_URL="sqlite://jobs.db"

# Binário Python para execução do bridge JobSpy (scripts/jobspy_bridge.py)
PYTHON_BIN="python3"

# Caminho padrão para o currículo em Markdown
RESUME_PATH="curriculo.md"

# Nível de log (trace, debug, info, warn, error)
RUST_LOG="info"
